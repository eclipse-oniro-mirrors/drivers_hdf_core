import("//build/test.gni")

hdf_framework_path = "//drivers/hdf_core/framework"
module_output_path = "hdf_core/hdf_core"

ohos_unittest("hdf_utils_slist_test") {
  module_out_path = module_output_path

  include_dirs = [
    "$hdf_framework_path/../interfaces/inner_api/utils",
    "$hdf_framework_path/../interfaces/inner_api/osal/uhdf",
  ]

  defines = [ "__USER__" ]

  sources = [
    "hdf_slist_test.cpp",
    "$hdf_framework_path/utils/src/hdf_slist.c",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
    "-fsigned-char",
    "-fno-common",
    "-fno-strict-aliasing",
  ]

  deps = [
    "//drivers/hdf_core/adapter/build/test_common:libhdf_test_common",
  ]

  external_deps = [
    "hilog:libhilog",
    "bounds_checking_function:libsec_shared",
  ]
}

ohos_unittest("hdf_utils_map_test") {
  module_out_path = module_output_path

  include_dirs = [
    "$hdf_framework_path/../interfaces/inner_api/utils",
    "$hdf_framework_path/../interfaces/inner_api/osal/uhdf",
    "$hdf_framework_path/../interfaces/inner_api/osal/shared",
  ]

  defines = [ "__USER__" ]

  sources = [
    "hdf_map_test.cpp",
    "$hdf_framework_path/utils/src/hdf_map.c",
    "$hdf_framework_path/utils/src/hdf_cstring.c",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
    "-fsigned-char",
    "-fno-common",
    "-fno-strict-aliasing",
  ]

  deps = [
    "//drivers/hdf_core/adapter/build/test_common:libhdf_test_common",
  ]

  external_deps = [
    "hilog:libhilog",
    "bounds_checking_function:libsec_shared",
  ]
}
